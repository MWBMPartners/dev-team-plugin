{
  "name": "discovery changes: a model disappears, then a provider fails",
  "providers": [ { "id": "a", "models": [ { "id": "a-big", "tier": 3 }, { "id": "a-old", "tier": 2 } ] } ],
  "steps": [
    { "do": "discover" },
    { "do": "remove", "provider": "a", "model": "a-old" },
    { "do": "discover", "refresh": true },
    { "do": "discover", "refresh": true },
    { "do": "fail", "provider": "a" },
    { "do": "discover", "refresh": true }
  ],
  "expect": [
    { "name": "the vanished model is RETIRED after two misses", "provider": "a", "model": "a-old", "lifecycle": "RETIRED" },
    { "name": "the good model is still known after a failed refresh", "provider": "a", "model": "a-big", "lifecycle": "ACTIVE" },
    { "name": "the failed provider is marked stale", "provider": "a", "stale": true },
    { "name": "the failure is reported", "problem": "DISCOVERY_FAILED" }
  ]
}
